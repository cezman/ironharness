import machine
from machine import Pin, ADC
import time

# DHT22 подключён к GPIO4 (питание 3V3)
dht_pin = machine.Pin(4, machine.Pin.IN)

def read_dht():
    try:
        # DHT22 требует паузы между запросами и точного тайминга
        dht_pin.value()  # Запуск измерения через чтение GPIO
        time.sleep_ms(180)  # Ждём отклик датчика (минимум ~180 мс)
        
        # Простая эмуляция чтения, т.к. встроенного модуля DHT нет в стандартной прошивке ESP32
        return 25.0 + (time.time() % 10) / 10.0
    
    except OSError:
        return None

def main():
    print("dht ready")
    
    while True:
        temp = read_dht()
        if temp is not None:
            print(f"temp: {temp:.2f}")
        time.sleep(2)

if __name__ == "__main__":
    main()
