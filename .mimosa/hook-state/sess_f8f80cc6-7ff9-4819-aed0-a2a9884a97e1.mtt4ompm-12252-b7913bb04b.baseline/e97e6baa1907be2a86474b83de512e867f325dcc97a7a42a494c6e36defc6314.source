import time
from machine import Pin

# GPIO4 Button (Active Low), Internal Pull-Up Resistor enabled
btn = Pin(4, mode=Pin.IN, pull=Pin.PULL_UP)

press_count = 0
last_press_time_ms = -1 # Initialize to ensure first press passes debounce check
prev_val = 1 # Initial state: Released (High due to Pull Up)
first_run = True

while True:
    current_val = btn.value()
    now = time.ticks_ms()
    
    # Detect Falling Edge (Transition from Released High -> Pressed Low)
    if prev_val == 1 and current_val == 0:
        # For first run, always allow the press
        is_first = (last_press_time_ms == -1)
        
        diff = time.ticks_diff(now, last_press_time_ms) if not is_first else 999999
        
        # Debounce check: Ignore press events closer than 30ms to the last valid one
        if diff >= 30 or is_first:
            press_count += 1
            print(f"presses: {press_count}")
            last_press_time_ms = now
    
    prev_val = current_val

    time.sleep(0.005) # Small delay to reduce CPU usage
