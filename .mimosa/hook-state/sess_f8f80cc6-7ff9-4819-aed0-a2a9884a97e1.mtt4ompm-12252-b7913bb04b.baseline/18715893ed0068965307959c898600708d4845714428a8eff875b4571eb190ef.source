from machine import Pin
import time

# GPIO Pins Configuration (Common ESP32 Dev Kit V1)
LED_RED_PIN = 25
LED_GREEN_PIN = 26
LED_YELLOW_PIN = 27

led_red = Pin(LED_RED_PIN, Pin.OUT)
led_green = Pin(LED_GREEN_PIN, Pin.OUT)
led_yellow = Pin(LED_YELLOW_PIN, Pin.OUT)

def set_lights(state):
    """Update LED states based on current traffic light state."""
    if state == 'red':
        led_red.value(1)
        led_green.value(0)
        led_yellow.value(0)
    elif state == 'green':
        led_red.value(0)
        led_green.value(1)
        led_yellow.value(0)
    else:  # yellow
        led_red.value(0)
        led_green.value(0)
        led_yellow.value(1)

def run_fsm():
    """Execute the traffic light finite state machine."""
    states = ['red', 'green', 'yellow']
    durations = {'red': 3, 'green': 3, 'yellow': 1}
    
    current_idx = 0
    # Initial entry into Red state
    state = states[0]
    set_lights(state)
    print(f"state: {state}")

    while True:
        time.sleep(durations[state])
        
        # Transition to next state cyclically
        current_idx += 1
        if current_idx >= len(states):
            current_idx = 0
            
        new_state = states[current_idx]
        set_lights(new_state)
        print(f"state: {new_state}")

if __name__ == '__main__':
    run_fsm()
