import machine
import time

# GPIO настройки для ESP32 (настройте под вашу схему)
PIN_RED = 15
PIN_GREEN = 4
PIN_YELLOW = 26

def main():
    # Инициализация светодиодов как выходов
    red_led = machine.Pin(PIN_RED, machine.Pin.OUT)
    green_led = machine.Pin(PIN_GREEN, machine.Pin.OUT)
    yellow_led = machine.Pin(PIN_YELLOW, machine.Pin.OUT)
    
    # Сброс всех светодиодов в начальное состояние
    red_led.value(0)
    green_led.value(0)
    yellow_led.value(0)
    
    # Конфигурация состояний с временем и следующими переходами
    states = [
        ("red", 3.0, "green"),
        ("green", 3.0, "yellow"),
        ("yellow", 1.0, "red")
    ]
    
    current_index = 0
    
    while True:
        state_name, duration, next_state = states[current_index]
        
        # Включение правильного светодиода для текущего состояния
        if state_name == "red":
            red_led.value(1)
            green_led.value(0)
            yellow_led.value(0)
        elif state_name == "green":
            red_led.value(0)
            green_led.value(1)
            yellow_led.value(0)
        elif state_name == "yellow":
            red_led.value(0)
            green_led.value(0)
            yellow_led.value(1)
        
        # Печать состояния в формате "state: <имя>"
        print("state: {}".format(state_name))
        
        # Задержка по времени для каждого состояния
        time.sleep(duration)
        
        # Переход к следующему состоянию циклично
        current_index = current_index + 1
        if current_index >= len(states):
            current_index = 0

if __name__ == "__main__":
    main()
