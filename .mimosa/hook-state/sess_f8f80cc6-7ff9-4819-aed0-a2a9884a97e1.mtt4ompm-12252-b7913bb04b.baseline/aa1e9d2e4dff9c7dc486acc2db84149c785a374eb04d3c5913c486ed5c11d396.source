import machine
import time

# GPIO Pins configuration (Adjust according to your specific ESP32 board)
RED_PIN = 26
GREEN_PIN = 25
YELLOW_PIN = 33

red_led = machine.Pin(RED_PIN, machine.Pin.OUT)
green_led = machine.Pin(GREEN_PIN, machine.Pin.OUT)
yellow_led = machine.Pin(YELLOW_PIN, machine.Pin.OUT)

def turn_red():
    red_led.value(1)
    green_led.value(0)
    yellow_led.value(0)

def turn_green():
    red_led.value(0)
    green_led.value(1)
    yellow_led.value(0)

def turn_yellow():
    red_led.value(0)
    green_led.value(0)
    yellow_led.value(1)

while True:
    print("state: red")
    turn_red()
    time.sleep(3.0)

    print("state: green")
    turn_green()
    time.sleep(3.0)

    print("state: yellow")
    turn_yellow()
    time.sleep(1.0)
