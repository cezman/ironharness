import machine
from time import ticks_ms

# Инициализация кнопки на GPIO4 с внутренним подтягиванием к питанию (PullUp)
# При отпускании кнопка - высокий уровень, при нажатии - низкий
btn = machine.Pin(4, machine.Pin.IN, machine.Pull.UP)

count = 0
last_press_time_ms = -1
debounce_delay = 30  # мс

while True:
    if not btn.value():  # Кнопка активна (замкнута на землю -> Low)
        current_time = ticks_ms()
        
        # Проверка на debounce (минимум 30 мс между переходами в состояние нажатия)
        if last_press_time_ms == -1 or (current_time - last_press_time_ms) >= debounce_delay:
            count += 1
            print(f"presses: {count}")
            last_press_time_ms = current_time
    
    # Небольшая задержка для снижения нагрузки на CPU и дополнительного фильтрации помех
    import time
    time.sleep(20)
