import machine
from machine import Pin, ADC
import time
try:
    from adafruit_dht import DHTSensor, DHT22 as DHT
except ImportError:
    try:
        from dht import DHT22 as DHT
    except ImportError:
        print("DHT library not found")
        exit()

dht_pin = machine.Pin(4)
try:
    sensor = DHT(dht_pin, DHT.DHT22)
except Exception as e:
    print(f"DHT initialization error: {e}")
    exit()

print("dht ready")

while True:
    try:
        temp = sensor.temperature()
        if temp is not None:
            print(f"temp: {temp:.2f}")
    except OSError:
        pass
    
    time.sleep(2)
