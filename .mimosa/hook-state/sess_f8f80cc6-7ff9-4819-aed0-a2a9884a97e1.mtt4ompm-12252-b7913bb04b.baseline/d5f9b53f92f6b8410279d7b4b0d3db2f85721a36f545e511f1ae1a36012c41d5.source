from machine import Pin
import time

# Подключение библиотеки DHT (стандартная для MicroPython ESP32, устанавливается через pip)
try:
    from dht import DHT22
except ImportError:
    print("dht library not installed")
    while True:
        time.sleep(1)

# Инициализация датчика на GPIO4
sensor = DHT22(Pin(4))

print("dht ready")

while True:
    try:
        sensor.measure()
        temp = sensor.temperature()
        print(f"temp: {temp}")
    except OSError:
        # Ошибка чтения не фатальная, просто продолжаем цикл
        pass
    
    time.sleep(2)
