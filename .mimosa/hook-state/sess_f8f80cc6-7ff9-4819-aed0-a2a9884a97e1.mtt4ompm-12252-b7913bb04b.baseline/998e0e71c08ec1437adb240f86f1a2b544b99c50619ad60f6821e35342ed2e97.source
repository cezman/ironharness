from machine import Pin, UART

# Инициализация последовательного порта
uart = UART(0, baudrate=115200)

# Настройка GPIO для светодиода (GPIO2)
led = Pin(2, Pin.OUT)

# Переменная состояния светодиодов
state_led = False

# Сообщение при старте системы
print("proto v1")

# Основной цикл обработки протокола
while True:
    # Чтение данных из порта UART
    data = uart.readline()
    
    if not data or len(data) == 0:
        continue
    
    # Декодирование и очистка строки
    command = data.decode('utf-8').strip()
    
    if command == "led on":
        led.value(1)
        state_led = True
        print("OK")
        
    elif command == "led off":
        led.value(0)
        state_led = False
        print("OK")
        
    elif command == "state?":
        status = "on" if state_led else "off"
        print(f"state: {status}")
        
    elif command:
        print("ERR unknown")
